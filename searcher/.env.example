# Shared secret the backend sends as X-Searcher-Key (must equal SEARCHER_API_KEY in backend/.env).
# Unset = every search request is refused (401).
SEARCHER_API_KEY=dev-local-searcher-key

# REQUIRED. The bike database the offers are written into — the same one the backend reads.
# Local PostgreSQL 17 in Docker (biker-pg, see README). There is no SQLite fallback here.
DATABASE_URL=postgresql+psycopg://biker:biker@localhost:5432/biker

# Server only: the Claude subscription token for the claude CLI (`claude setup-token`).
# Locally the CLI uses your `claude` login, so leave this unset. Never commit a real value.
# CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-...

# Playwright photo scraping (OLX listings and bike photos — Decathlon and Allegro runs launch no browser). true = no browser window
# (required in Docker / on a server); unset = visible browser.
# PLAYWRIGHT_HEADLESS=true

# Seconds one `claude -p` run may take before it is killed (default 300).
# SEARCHER_CLI_TIMEOUT=300

# Model the CLI runs (default claude-haiku-4-5-20251001).
# SEARCHER_CLAUDE_MODEL=claude-haiku-4-5-20251001

# Path to the claude CLI when it is not on PATH (default: `claude` / claude.exe on PATH).
# CLAUDE_BIN=/usr/bin/claude

# Searches (CLI runs; the OLX and photo ones also open a browser) allowed at once, counted across the four
# search routes (olx / decathlon / allegro / photos); a further request gets 503 "searcher busy". Default 10.
# SEARCHER_MAX_CONCURRENT=10

# Browsers (Chromium) allowed at once in this process — OLX and photo searches wait for a free one.
# Each costs 0.5–0.9 GiB, so this stays low even with 10 search slots. Default 2.
# BROWSER_MAX_CONCURRENCY=2
