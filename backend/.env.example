ANTHROPIC_API_KEY=sk-ant-api03-...

# Amazon Product Advertising API (PA-API) 5.0 — used by POST /v1/bike/amazon.
# Requires a verified Amazon Associate account with qualifying sales activity.
# All three are required for the endpoint to return offers; if any is missing
# the endpoint returns 200 with empty offers and an explanatory `info` string.
AMAZON_ACCESS_KEY=
AMAZON_SECRET_KEY=
AMAZON_PARTNER_TAG=your-associate-tag-20
# Marketplace endpoint. Defaults below target amazon.com (US).
# For amazon.de use region=eu-west-1, host=webservices.amazon.de
# For amazon.pl use region=eu-west-1, host=webservices.amazon.pl
AMAZON_REGION=us-east-1
AMAZON_HOST=webservices.amazon.com
