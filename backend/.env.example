ANTHROPIC_API_KEY=sk-ant-api03-...

# Allegro REST API (OAuth2 client-credentials) — used by POST /v1/bike/allegro
# Register an application at https://apps.developer.allegro.pl/ to obtain these.
# NOTE: GET /offers/listing requires a *verified* Allegro application.
#       Use the sandbox for development (default). Set ALLEGRO_ENV=production
#       once your app is verified to hit the live api.allegro.pl.
ALLEGRO_CLIENT_ID=
ALLEGRO_CLIENT_SECRET=
# ALLEGRO_ENV=sandbox   # sandbox (default) | production
