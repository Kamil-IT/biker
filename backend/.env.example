ANTHROPIC_API_KEY=sk-ant-api03-...

# Database (TODO-028). Unset = SQLite file backend/cache.db. Local Postgres: docker container biker-pg (see README).
# DATABASE_URL=postgresql+psycopg://biker:biker@localhost:5432/biker

# GCP Cloud SQL (biker-pg) through the Cloud SQL Auth Proxy on the host:
#   cloud-sql-proxy --gcloud-auth --port 6543 biker-engine-prod:europe-central2:biker-pg
# No password in the URL — libpq reads it from the gitignored pgpass file (one line: 127.0.0.1:6543:biker:biker:<password>).
# Use an absolute PGPASSFILE path so scripts run from any directory find it.
# DATABASE_URL=postgresql+psycopg://biker@127.0.0.1:6543/biker
# PGPASSFILE=C:\path\to\biker\backend\gcp-prod-pgpass.conf

# Playwright photo scraping. true = no browser window (required in Docker / on a server); unset = visible browser.
# PLAYWRIGHT_HEADLESS=true
