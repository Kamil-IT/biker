ANTHROPIC_API_KEY=sk-ant-api03-...

# OLX Partner API (used-bike listings via /v1/bike/used-api)
# Obtain from your approved OLX developer account. When unset, the endpoint
# degrades gracefully to an empty offers list.
OLX_CLIENT_ID=
OLX_CLIENT_SECRET=
# sandbox | production (default: sandbox)
OLX_ENV=sandbox
